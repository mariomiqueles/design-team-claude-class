---
export interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Aprende Claude para diseño UX/UI y design systems — Leniolabs / Improving' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} — Claude para Diseño UX/UI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen">

  <!-- Nav -->
  <nav class="border-b border-slate-800 bg-slate-950/80 backdrop-blur sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
      <a href={base} class="flex items-center gap-2 font-semibold text-white">
        <span class="w-7 h-7 rounded-lg bg-brand-500 flex items-center justify-center text-xs font-bold">C</span>
        Claude para Diseño
      </a>
      <div class="flex items-center gap-6 text-sm text-slate-400">
        <a href={`${base}/modulos`} class="hover:text-white transition-colors">Módulos</a>
        <a href={`${base}/changelog`} class="hover:text-white transition-colors">Novedades</a>
        <a href="https://claude.ai" target="_blank" rel="noopener" class="bg-brand-500 hover:bg-brand-600 text-white px-3 py-1.5 rounded-lg transition-colors">
          Abrir Claude →
        </a>
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-800 mt-24 py-12 text-center text-slate-500 text-sm">
    <p>Hecho para el equipo de diseño de <strong class="text-slate-400">Leniolabs / Improving</strong></p>
    <p class="mt-1">Contenido actualizado automáticamente con cada release de Claude</p>
  </footer>

</body>
</html>
